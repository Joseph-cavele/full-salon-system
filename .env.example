# Copy this file to `.env` and fill in the values. Never commit your real `.env`.

# App — public base URL of the site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Salon timezone (IANA name). Used to resolve "today" for the dashboard so the
# count stays correct on UTC servers. Defaults to Africa/Johannesburg (SAST).
SALON_TIMEZONE=Africa/Johannesburg

# MongoDB — Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?appName=<app>

# Auth.js — session secret + canonical URL
# Generate a strong secret with:  npx auth secret   (or: openssl rand -base64 32)
# Also the HMAC key for stored sign-in codes, so changing it invalidates any
# codes in flight (and signs everyone out). Required — sign-in fails without it.
# Use an https AUTH_URL in production: Auth.js then marks the session cookie Secure.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Cloudinary — image uploads (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — transactional email (https://resend.com/api-keys)
# The sender must be on a domain verified in Resend (Domains tab); until it is,
# Resend only delivers to your own Resend account address. onboarding@resend.dev
# works for that local-only testing.
RESEND_API_KEY=
# Sender for all email, including sign-in codes. EMAIL_FROM wins if both are
# set; RESEND_FROM_EMAIL is the older name and still works.
EMAIL_FROM=Salon <booking@your-verified-domain.com>
RESEND_FROM_EMAIL=

# Owner email: receives "new booking" emails AND is the owner's sign-in address
# (sign-in codes are emailed to it). Create/update the account from it with
# `npm run setup-owner`.
#
# Rate limiting for sign-in needs no extra service or variables — counters are
# stored in MongoDB (rate_limits collection), shared by every server instance.
OWNER_EMAIL=

# Paystack — online booking payments (https://dashboard.paystack.com/#/settings/developers)
#
# Test mode keys start sk_test_ / pk_test_; live keys start sk_live_ / pk_live_.
# The SECRET key must never reach the browser — it can charge cards and issue
# refunds. It is read only in lib/paystack.ts, which is server-only, and it has
# no NEXT_PUBLIC_ prefix precisely so Next cannot bundle it into client code.
PAYSTACK_SECRET_KEY=
# Public key. Not used by the current redirect flow (the browser never talks to
# Paystack directly), but safe to expose and needed if you ever switch to the
# inline popup checkout.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
#
# Webhook: set this in the Paystack dashboard, not here —
#   https://<your-domain>/api/payments/webhook
# It is the reliable half of the flow: the browser callback only fires if the
# customer returns to the tab, and many close it as soon as their bank app
# confirms. Paystack cannot reach localhost, so use a tunnel (ngrok, cloudflared)
# when testing webhooks locally. Signatures are verified against
# PAYSTACK_SECRET_KEY, so no separate webhook secret is needed.
#
# NEXT_PUBLIC_APP_URL above builds the return URL Paystack redirects to. If it
# is wrong, paying customers land on the wrong host after checkout.
